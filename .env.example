# Parva MVP — configuración (todo opcional; corre local sin nada de esto)
# Puerto del servidor web + API
PORT=3000

# Ruta del archivo SQLite (por default: ./data/parva.db)
# DB_PATH=./data/parva.db

# Parser: auto | mock | local | bedrock  (default: auto)
#   auto   -> bedrock si hay credenciales AWS; si no modelo local si Ollama
#             corre; si no, mock.
#   bedrock-> Amazon Nova Lite sobre Bedrock (ver más abajo).
#   local  -> modelo chico vía Ollama (server local). Requiere: instalar Ollama y
#             `ollama pull qwen2.5:3b`. Si Ollama no responde, cae al mock.
#   mock   -> reglas determinísticas en español, sin modelo. Default del MVP.
PARSER_MODE=auto
LOCAL_MODEL=qwen2.5:3b
OLLAMA_URL=http://localhost:11434

# --- Bedrock (Nova Lite) ---------------------------------------------------
# Camino por default cuando hay credenciales AWS en el entorno.
#
# Las del SSO son temporales y vencen: se exportan con
#   eval "$(aws configure export-credentials --profile TU_PERFIL --format env)"
# No las pegues acá si usás ese comando (ya quedan en el entorno).
#
# La región tiene que ser us-east-2: el rol del curso tiene deny explícito
# fuera de ahí. Por eso también Nova Micro/Pro quedan descartados, que exigen
# perfil de inferencia entre regiones y rutean a us-west-2.
AWS_REGION=us-east-2
BEDROCK_MODEL_ID=amazon.nova-lite-v1:0
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# Umbral de confianza del parser para pedir confirmación antes de guardar (0..1)
CONFIDENCE_THRESHOLD=0.7

# --- WhatsApp --------------------------------------------------------------
# sim  (default): el bot responde en el body del webhook (simulador web, curl).
#                 NO exponer a internet: el endpoint queda sin autenticar.
# meta          : Cloud API real (requiere las META_* de abajo).
WHATSAPP_MODE=sim

# Token del handshake GET. Lo inventás vos; tiene que coincidir con el que
# cargues en el panel de Meta.
META_VERIFY_TOKEN=parva-dev

# App ID (Settings → Basic). Solo lo usa `npm run check-meta`, para preguntarle
# a Meta a qué WABA llega tu token en vez de que la busques a mano.
META_APP_ID=

# App Secret (Settings → Basic). Verifica la firma X-Hub-Signature-256.
# Sin esto el modo meta rechaza TODO webhook (falla cerrado).
META_APP_SECRET=

# Access token (panel API Setup). El temporal dura 24 h; ver README.
META_ACCESS_TOKEN=

# Phone number ID (panel API Setup) — es un ID numérico largo, NO el número
# de teléfono que aparece al lado. Confundirlos da error 100.
#
# Solo se usa como FALLBACK: el bot contesta desde el número que recibió el
# mensaje (lo saca de `metadata.phone_number_id` del webhook). Poné acá el ID
# de TU número, no el del de test, o los envíos sin webhook previo saldrán
# desde el +1 555… y sólo a los 5 destinatarios de prueba.
META_PHONE_NUMBER_ID=

# Versión de Graph: copiala del curl de ejemplo del panel de Meta.
META_GRAPH_VERSION=v25.0

# 1 = responder a números no registrados. Default: los ignora (solo loguea).
META_REPLY_TO_UNKNOWN=0

# WhatsApp Business Account ID. Opcional: `npm run check-meta` lo deduce solo si
# el token expone la WABA, pero un token de System User sin la WABA asignada como
# asset no la expone y el chequeo de suscripción queda INCOMPLETO. Si te pasa
# eso, el ID aparece en el log `[wa] ←` con el primer mensaje que entra.
META_WABA_ID=

# Dominio ngrok reservado (dashboard.ngrok.com/domains — el free tier da uno).
# Con esto la callback URL es FIJA: se registra en Meta una sola vez. Sin esto
# ngrok da una URL nueva en cada restart y hay que volver a registrarla, que es
# la causa más común de que el bot deje de contestar de un día para el otro.
NGROK_DOMAIN=
