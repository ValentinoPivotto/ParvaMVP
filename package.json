{
  "name": "parva-mvp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Parva — MVP: ERP agropecuario por WhatsApp. Web app + backend del bot (WhatsApp e IA mockeados). Cero dependencias.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.ts",
    "dev": "node --env-file-if-exists=.env --watch src/server.ts",
    "seed": "node --env-file-if-exists=.env src/seed.ts",
    "reset": "node --env-file-if-exists=.env src/seed.ts --reset",
    "link-phone": "node --env-file-if-exists=.env src/link-phone.ts"
  }
}
