{
  "name": "parva-mvp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Parva — MVP: ERP agropecuario por WhatsApp. Web app + backend del bot (WhatsApp e IA mockeados). Cero dependencias.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env backend/handler/server.ts",
    "dev": "node --env-file-if-exists=.env --watch backend/handler/server.ts",
    "seed": "node --env-file-if-exists=.env backend/repository/seed.ts",
    "reset": "node --env-file-if-exists=.env backend/repository/seed.ts --reset",
    "link-phone": "node --env-file-if-exists=.env backend/scripts/link-phone.ts",
    "check-meta": "node --env-file-if-exists=.env backend/scripts/check-meta.ts",
    "tunnel": "node --env-file-if-exists=.env backend/scripts/tunnel.ts"
  }
}
